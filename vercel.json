{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://landing-origin.weiverai.com/"
    },
    {
      "source": "/landing-assets/:path*",
      "destination": "https://landing-origin.weiverai.com/landing-assets/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://landing-origin.weiverai.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://landing-origin.weiverai.com/sitemap.xml"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/login/password-reset",
      "destination": "/app.html"
    },
    {
      "source": "/signup/account-info",
      "destination": "/app.html"
    },
    {
      "source": "/signup/agreements",
      "destination": "/app.html"
    },
    {
      "source": "/home",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/reservation_v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reservation_v2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing-assets/reservation_v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing-assets/reservation_v2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing-assets/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing-assets",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
