{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://landing-origin.weiverai.com/"
    },
    {
      "source": "/landing-assets/:path*",
      "destination": "https://landing-origin.weiverai.com/landing-assets/:path*"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/login/password-reset",
      "destination": "/app.html"
    },
    {
      "source": "/signup/account-info",
      "destination": "/app.html"
    },
    {
      "source": "/signup/agreements",
      "destination": "/app.html"
    },
    {
      "source": "/auth/kakao/return",
      "destination": "/app.html"
    },
    {
      "source": "/signup/kakao",
      "destination": "/app.html"
    },
    {
      "source": "/home",
      "destination": "/app.html"
    },
    {
      "source": "/resume/master",
      "destination": "/app.html"
    },
    {
      "source": "/preparation",
      "destination": "/app.html"
    },
    {
      "source": "/preparation/new",
      "destination": "/app.html"
    },
    {
      "source": "/preparation/:postingId",
      "destination": "/app.html"
    },
    {
      "source": "/preparation/:postingId/edit",
      "destination": "/app.html"
    },
    {
      "source": "/preparation/:postingId/resume",
      "destination": "/app.html"
    },
    {
      "source": "/preparation/:postingId/cover-letter",
      "destination": "/app.html"
    },
    {
      "source": "/preparation/:postingId/portfolio",
      "destination": "/app.html"
    }
  ]
}
